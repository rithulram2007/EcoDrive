# EcoDrive Environment Variables Template

# --- BACKEND (backend/.env) ---
ENVIRONMENT=development
DATABASE_URL=sqlite:///./ecodrive.db
# For PostgreSQL (e.g. Render / Railway / Supabase):
# DATABASE_URL=postgresql://postgres:password@host:5432/ecodrivedb

PORT=8000

# --- FRONTEND (frontend/.env) ---
# Leave empty for Vite local proxy (/api -> http://127.0.0.1:8000)
# In production, set to your backend deployment URL:
# VITE_API_BASE_URL=https://ecodrive-api.onrender.com
